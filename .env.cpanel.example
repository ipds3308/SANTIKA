# Copy these settings into the production .env file on the cPanel server.
# Replace every value marked REPLACE_ME. Never commit the real production .env.

APP_NAME="SANTIKA BPS"
APP_ENV=production
APP_KEY=base64:REPLACE_ME_WITH_OUTPUT_FROM_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Use the exact database name and username shown in cPanel.
# cPanel often prefixes both with the account username.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_ACCOUNT_DATABASE
DB_USERNAME=CPANEL_ACCOUNT_DATABASE_USER
DB_PASSWORD=REPLACE_ME_WITH_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Database-backed sessions, cache, and queue require the Laravel migrations.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.example
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# Laravel (server-side) connects to Reverb on the same hosting account.
# Keep these values aligned with the Reverb process and its internal port.
REVERB_APP_ID=REPLACE_ME_WITH_UNIQUE_APP_ID
REVERB_APP_KEY=REPLACE_ME_WITH_RANDOM_PUBLIC_KEY
REVERB_APP_SECRET=REPLACE_ME_WITH_RANDOM_SECRET
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# The browser connects to the public WebSocket hostname behind a TLS proxy.
# Configure that proxy in cPanel to forward secure WebSocket traffic to port 8080.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=ws.your-domain.example
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Configure these using the SMTP details provided by the hosting provider.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.your-domain.example
MAIL_PORT=587
MAIL_USERNAME=your-mailbox@your-domain.example
MAIL_PASSWORD=REPLACE_ME_WITH_MAIL_PASSWORD
MAIL_FROM_ADDRESS=your-mailbox@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# If the cPanel plan does not support persistent Reverb and queue processes,
# use this fallback instead:
# BROADCAST_CONNECTION=log
# QUEUE_CONNECTION=sync
# VITE_REVERB_APP_KEY=
# The admin table will then use its periodic refresh fallback, not WebSockets.
